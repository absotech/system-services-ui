polkit.addRule(function(action, subject) {
    if (subject.user !== "system-services-ui") {
        return;
    }

    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return;
    }

    var unit = action.lookup("unit");
    if (!unit) {
        return;
    }

    try {
        polkit.spawn(["/usr/bin/system-services-ui", "check-unit", unit]);
    } catch (e) {
        // Non-zero exit: unit not allowed, fall through.
        return;
    }

    return polkit.Result.YES;
});
